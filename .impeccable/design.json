  "components": [
    {
      "name": "Primary confirmation",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compact tinted confirmation action.",
      "html": "<button class=\"ds-primary\">Create workspace</button>",
      "css": ".ds-primary{font-family:var(--ui-font,'Segoe UI',system-ui,sans-serif);padding:5px 14px;border:1px solid var(--ui-accent,#0091ff);border-radius:5px;background:color-mix(in srgb,var(--ui-accent,#0091ff) 20%,transparent);color:var(--ui-text-primary,#e8edf5);font-size:12px;cursor:pointer}.ds-primary:hover{background:color-mix(in srgb,var(--ui-accent,#0091ff) 35%,transparent)}.ds-primary:focus-visible{outline:1px solid var(--ui-accent,#0091ff);outline-offset:1px}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Settings secondary action with a quiet overlay fill.",
      "html": "<button class=\"ds-secondary\">Browse</button>",
      "css": ".ds-secondary{font-family:var(--ui-font,'Segoe UI',system-ui,sans-serif);padding:5px 12px;border-radius:6px;font-size:12px;font-weight:500;border:1px solid rgba(var(--ui-overlay-rgb,255,255,255),.1);background:rgba(var(--ui-overlay-rgb,255,255,255),.08);color:rgba(var(--ui-overlay-rgb,255,255,255),.75);cursor:pointer;transition:background .1s}.ds-secondary:hover{background:rgba(var(--ui-overlay-rgb,255,255,255),.14);color:var(--ui-text-primary,#e8edf5)}.ds-secondary:focus-visible{outline:2px solid var(--ui-accent,#0091ff);outline-offset:-2px;}.ds-secondary:disabled{opacity:.65;cursor:default}"
    },
    {
      "name": "Settings field",
      "kind": "input",
      "refersTo": "input",
      "description": "Raised compact text field with accent focus.",
      "html": "<input class=\"ds-input\" aria-label=\"Workspace name\" value=\"wmux\"/>",
      "css": ".ds-input{font-family:var(--ui-font,'Segoe UI',system-ui,sans-serif);background:var(--ui-bg-4,#303947);border:1px solid rgba(var(--ui-overlay-rgb,255,255,255),.12);border-radius:6px;color:var(--ui-text-primary,#e8edf5);font-size:12.5px;padding:5px 10px;outline:none;min-width:200px;transition:border-color .15s}.ds-input:focus,.ds-input:focus-visible{border-color:var(--ui-accent,#0091ff)}"
    },
    {
      "name": "Active workspace",
      "kind": "nav",
      "refersTo": "workspace-row",
      "description": "Selection retains readable task status and branch context.",
      "html": "<button class=\"ds-workspace\"><span class=\"ds-name\">wmux</span><span class=\"ds-status\">Needs you</span><span class=\"ds-context\">master \u00b7 ~/wmux</span></button>",
      "css": ".ds-workspace{font-family:var(--ui-font,'Segoe UI',system-ui,sans-serif);display:flex;flex-direction:column;position:relative;min-width:210px;text-align:left;padding:8px 10px 8px 14px;border:0;border-radius:8px;cursor:pointer;background:color-mix(in srgb,var(--ui-accent,#0091ff) 8%,var(--ui-bg-2,#202530));box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--ui-accent,#0091ff) 24%,var(--ui-border,#343e4e));transition:background-color .12s ease,box-shadow .12s ease}.ds-workspace:before{content:\"\";position:absolute;left:4px;top:50%;transform:translateY(-50%);width:2px;height:16px;border-radius:2px;background:var(--ui-accent,#0091ff)}.ds-name{font-size:12.5px;font-weight:600;line-height:1.3;color:var(--ui-text-primary,#e8edf5);margin-bottom:2px}.ds-status{font-size:11px;line-height:1.3;font-weight:600;color:var(--ui-agent-blocked,#b388ff);margin-top:2px}.ds-context{font-family:\"Cascadia Mono\",Consolas,monospace;font-size:10.5px;line-height:1.4;color:var(--ui-text-secondary,#bac5d5);margin-top:1px}.ds-workspace:hover{background:rgba(var(--ui-overlay-rgb,255,255,255),.04)}.ds-workspace:focus-visible{outline:2px solid var(--ui-accent,#0091ff);outline-offset:-2px;}"
    },
    {
      "name": "Selected surface tab",
      "kind": "nav",
      "refersTo": "surface-tab",
      "description": "Inset active tab using the focused frame accent.",
      "html": "<button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\"><svg aria-hidden=\"true\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 6 6 6-6 6M14 18h4\"/></svg><span>PowerShell</span></button>",
      "css": ".ds-tab{font-family:var(--ui-font,'Segoe UI',system-ui,sans-serif);display:flex;align-items:center;height:24px;padding:0 8px;gap:6px;border:1px solid color-mix(in srgb,var(--ui-accent,#0091ff) 38%,var(--ui-border,#343e4e));border-radius:5px;background:color-mix(in srgb,var(--ui-accent,#0091ff) 14%,var(--ui-bg-3,#272e3a));color:var(--ui-text-primary,#e8edf5);font-size:12px;white-space:nowrap;cursor:pointer;transition:background .1s ease,color .1s ease}.ds-tab svg{color:var(--ui-text-muted,#96a3b7);flex-shrink:0}.ds-tab:hover{background:color-mix(in srgb,var(--ui-accent,#0091ff) 14%,var(--ui-bg-3,#272e3a))}.ds-tab:focus-visible{outline:2px solid var(--ui-accent,#0091ff);outline-offset:-2px;}"
    },
    {
      "name": "Pane frame",
      "kind": "card",
      "refersTo": "pane",
      "description": "Working surface with a flat frame and fixed pane header.",
      "html": "<section class=\"ds-pane\" aria-label=\"Focused pane\"><header class=\"ds-pane-head\">PowerShell</header><div class=\"ds-pane-body\">Terminal colors are independently configured.</div></section>",
      "css": ".ds-pane{font-family:var(--ui-font,'Segoe UI',system-ui,sans-serif);width:330px;border:1px solid color-mix(in srgb,var(--ui-accent,#0091ff) 55%,var(--ui-border,#343e4e));border-radius:var(--ui-pane-radius,8px);color:var(--ui-text-primary,#e8edf5);transition:border-color .15s ease}.ds-pane-head{height:32px;display:flex;align-items:center;padding:0 8px;border-radius:7px 7px 0 0;border-bottom:1px solid rgba(var(--ui-overlay-rgb,255,255,255),.06);background:var(--ui-bg-2,#202530);font-size:12px}.ds-pane-body{padding:12px;color:var(--ui-text-muted,#96a3b7);font-size:11px}"
    },
    {
      "name": "Surface action menu",
      "kind": "custom",
      "refersTo": "surface-menu",
      "description": "Portalled menu with compact SVG-led actions.",
      "html": "<div class=\"ds-menu\"><button><svg aria-hidden=\"true\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 6 6 6-6 6M14 18h4\"/></svg>New terminal</button><button><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"4\" width=\"7\" height=\"16\" rx=\"1.5\"/><rect x=\"14\" y=\"4\" width=\"7\" height=\"16\" rx=\"1.5\"/></svg>Split right</button></div>",
      "css": ".ds-menu{font-family:var(--ui-font,'Segoe UI',system-ui,sans-serif);min-width:180px;padding:5px;background:var(--ui-bg-1,#191d26);border:1px solid rgba(var(--ui-overlay-rgb,255,255,255),.14);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.6);display:flex;flex-direction:column}.ds-menu button{font-family:var(--ui-font,'Segoe UI',system-ui,sans-serif);display:flex;align-items:center;gap:10px;width:100%;padding:7px 10px;border:0;background:transparent;color:var(--ui-text-secondary,#bac5d5);font-size:13px;text-align:left;border-radius:5px;cursor:pointer}.ds-menu button:hover{background:rgba(var(--ui-accent-rgb,0,145,255),.18);color:var(--ui-text-primary,#e8edf5)}.ds-menu button:focus-visible{outline:2px solid var(--ui-accent,#0091ff);outline-offset:-2px;}.ds-menu svg{color:var(--ui-text-muted,#96a3b7)}.ds-menu button:hover svg{color:var(--ui-text-primary,#e8edf5)}"
    },
    {
      "name": "Worktree badge",
      "kind": "chip",
      "refersTo": "worktree-badge",
      "description": "Noninteractive annotation beside a workspace name.",
      "html": "<span class=\"ds-badge\">WT</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;justify-content:center;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:9.5px;font-weight:700;line-height:1;padding:1px 4px;border-radius:3px;user-select:none;color:var(--ui-accent,#0091ff);background:color-mix(in srgb,var(--ui-accent,#0091ff) 15%,transparent);border:1px solid color-mix(in srgb,var(--ui-accent,#0091ff) 40%,transparent)}"
    }
  ],
  "narrative": {
    "northStar": "Modular Swiss technical publishing",
    "overview": "A restrained slate shell holds dense, distinct working surfaces. Small inset tabs and soft rectangular frames separate concurrent tasks while keeping terminal content dominant. Familiar controls and stable labels support long working sessions.\n\nThe shared shell uses system sans labels, monochrome SVG controls, and precise selection marks. Cool white surfaces reuse the geometry in light mode. Classic and TRACE are existing sidebar presentations within this desktop system; terminal fonts, colors, backgrounds, and opacity remain independently configured.",
    "keyCharacteristics": [
      "Dense working surfaces with visible perimeter and split gutters.",
      "Matching accent treatment on the focused pane and its selected tab.",
      "Semantic agent attention remains distinct from navigation selection.",
      "Independent terminal themes; shared desktop chrome tokens."
    ],
    "rules": [
      {
        "name": "The State Before Decoration Rule",
        "body": "Selection must preserve readable agent state. The default workspace selection uses an accent rail, a slight tint, and an inset hairline; the user-selected solid-fill presentation remains supported.",
        "section": "colors"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Separate panes with the existing workspace inset and split gutters. Preserve dense headers and terminal area instead of adding dashboard padding.",
        "section": "layout"
      },
      {
        "name": "The Perimeter Paint Rule",
        "body": "In transparent windows, paint the workspace perimeter and dividers without adding a second translucent background beneath terminals. Keep the titlebar and sidebar opaque.",
        "section": "elevation"
      },
      {
        "name": "The Signal Motion Rule",
        "body": "TRACE motion follows actual activity. Idle rows do not animate; reduced motion retains static state information.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use shared UI variables for shell backgrounds, text, borders, and theme-aware accent colors.",
      "Do join the focused pane frame and selected tab through the existing accent mixes.",
      "Do preserve terminal color schemes, geometry measurement, keep-alive rendering, and user density preferences.",
      "Do use inline SVG for new chrome controls and preserve visible keyboard focus.",
      "Do retain classic and TRACE state meanings and reduced-motion equivalents."
    ],
    "donts": [
      "Don't paint another translucent layer beneath terminals when adding workspace spacing.",
      "Don't use navigation selection to erase default agent state colors.",
      "Don't turn pane frames into floating cards with permanent drop shadows.",
      "Don't inherit legacy glyph icons, fixed light-mode status colors, or small metadata sizes as a new display style."
    ]
  }
}
